# Copy to .env and fill in real values. Do not commit .env.

# PostgreSQL connection. Create an empty database named rosterly first.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rosterly?schema=public

# Long random string. Used only on the server to sign admin tokens.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Seeded administrator. Change before any shared deployment.
ADMIN_EMAIL=admin@datastraw.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

PORT=4000
CORS_ORIGIN=http://localhost:5173
